{
  "name": "better-wayback",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:ui": "node test/ui.js",
    "test:html-ui": "node test/html-ui.js",
    "test:previews": "node test/preview-scheduler.test.js",
    "test:timeline": "node test/timeline-ui.js",
    "build:cloudflare": "node tools/build-cloudflare.js",
    "test:cloudflare": "node --test test/cloudflare*.test.js",
    "check:cloudflare": "npm run build:cloudflare && wrangler deploy --dry-run --outdir .cache/cloudflare-bundle"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.4.0",
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
